#!/bin/bash

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

stop_action() {
  # Stopping omv-writecache-setup.service runs its ExecStop
  # (/usr/sbin/omv-writecache rotateunmount), which flushes pending writes and
  # unmounts the overlays. That has to happen here, in prerm, while
  # /usr/sbin/omv-writecache is still on disk -- dpkg removes it before postrm
  # runs, so stopping the unit from postrm can no longer run ExecStop.
  #
  # Do NOT also call `omv-writecache unmount` directly here: that duplicates
  # the exact teardown ExecStop is about to perform, and doing it twice back
  # to back has caused the second pass's unmount of /var/cache/apt/archives
  # to fuser-kill the very apt/dpkg process running this purge.
  units=(
    "omv-writecache-setup.service"
    "omv-writecache-teardown.service"
    "omv-writecache-flush.service"
    "omv-writecache-flush.timer"
  )
  for u in "${units[@]}"; do
    systemctl disable --now "${u}" >/dev/null 2>&1 || true
  done
}

case "$1" in
  remove|purge)
    stop_action
  ;;

  upgrade|failed-upgrade|deconfigure)
  ;;

  *)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
  ;;
esac

exit 0
